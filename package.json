{
  "name": "@0xarchive/mcp-server",
  "version": "1.9.4",
  "description": "MCP server that gives coding agents typed 0xArchive market data tools across Hyperliquid (perps, HIP-3, HIP-4, spot) and Lighter.xyz",
  "type": "module",
  "bin": {
    "0xarchive-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@0xarchive/sdk": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22.19.17"
  },
  "license": "MIT",
  "keywords": [
    "0xarchive",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "market-data",
    "hyperliquid",
    "lighterxyz",
    "orderbook",
    "agents",
    "claude",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0xArchiveIO/0xarchive-mcp"
  },
  "homepage": "https://www.0xarchive.io/github-mcp",
  "bugs": {
    "url": "https://github.com/0xArchiveIO/0xarchive-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
